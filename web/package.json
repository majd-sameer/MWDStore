{
  "name": "mystore-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prebuild": "ng lint",
    "build:libs": "ng build data-access && ng build util && ng build ui && ng build core",
    "build:apps": "ng build storefront && ng build admin",
    "build": "npm run build:libs && npm run build:apps",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:storefront": "node dist/storefront/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/animations": "^22.0.5",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@danielmoncada/angular-datetime-picker": "^21.0.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ng-select/ng-select": "^23.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",

{
  "//": "Copy to C:\\inetpub\\MyStore\\api\\appsettings.Production.json and fill in the real values. This file is NOT in the publish output and holds the only secrets — never commit the filled-in copy.",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=<SQL_HOST>;Initial Catalog=<DB_NAME>;User ID=<DB_USER>;Password=<DB_PASSWORD>;Encrypt=True;TrustServerCertificate=True"
